# Copia in .env e personalizza per il tuo ambiente.
# Tutte le variabili sono prefissate RISIKO_ (vedi app/configurazione/impostazioni.py).

# === Database ===
# Per dev rapido (zero Docker, file SQLite locale):
RISIKO_DATABASE_URL=sqlite+aiosqlite:///./risiko_review.db

# Per produzione/dev con Postgres (richiede docker-compose up):
# RISIKO_DATABASE_URL=postgresql+asyncpg://risiko:risiko_dev_password@localhost:5432/risiko_review

# Mostra le query SQL nei log (true/false)
RISIKO_DATABASE_ECHO=false

# === Storage video ===
# Cartella dove salvare i video caricati (creata automaticamente se non esiste)
RISIKO_STORAGE_VIDEO_PATH=./storage_video

# Dimensione massima upload in MB (default 10240 = 10 GB)
RISIKO_UPLOAD_MAX_SIZE_MB=10240

# === API ===
# Origini CORS consentite (per il frontend Vite/React)
RISIKO_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# === Generale ===
RISIKO_DEBUG=false
