# URL del backend Risiko Live Review (deploy Railway o locale)
# Esempio dev locale: http://192.168.1.100:8000  (IP del PC sulla rete WiFi)
# Esempio Railway:    https://risiko-review.up.railway.app
RISIKO_BACKEND_URL=http://localhost:8000

# Schema_version del bundle prodotto. Deve combaciare con quella supportata
# dal backend (cambia solo se introduci breaking changes).
RISIKO_BUNDLE_SCHEMA_VERSION=1.0
